---
import { useTranslations, type Locale } from '../i18n/ui';
import { projectPath, projectSlug, type Project } from '../lib/projects';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { data } = project;
const t = useTranslations(locale);
---

<article class="card">
  <h3><a href={projectPath(locale, projectSlug(project))}>{data.title}</a></h3>
  <p class="platform">{data.platform}</p>
  <p>{data.summary}</p>
  <ul class="stats">
    {data.stats.map((s) => <li><b>{s.value}</b> {s.label}</li>)}
  </ul>
  <p class="card-links">
    <a href={projectPath(locale, projectSlug(project))}>{t('project.details')}</a>
    <a href={data.links.repository}>GitHub</a>
    {data.links.packages?.map((p) => <a href={p.url}>{p.name} {t('link.pubDev')}</a>)}
  </p>
</article>
