---
import { useTranslations, type Locale } from '../i18n/ui';
import { projectPath, projectSlug, type Project } from '../lib/projects';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { data } = project;
const t = useTranslations(locale);
const detailsPath = projectPath(locale, projectSlug(project));
---

<article class="card">
  <div class="card-top">
    <h3><a href={detailsPath}>{data.title}</a></h3>
    <span class="platform">{data.platform}</span>
  </div>
  <p>{data.summary}</p>
  <ul class="stats">
    {data.stats.map((s) => <li><b>{s.value}</b> {s.label}</li>)}
  </ul>
  <p class="card-links">
    <a href={detailsPath} aria-label={`${t('project.details')}: ${data.title}`}>{t('project.details')} →</a>
    <a href={data.links.repository}>GitHub</a>
    {/* Con più pacchetti i nomi non stanno in una riga: stanno nella pagina del progetto. */}
    {data.links.packages?.length === 1 && <a href={data.links.packages[0]!.url}>pub.dev</a>}
    {data.links.releases && <a href={data.links.releases}>{t('link.releases')}</a>}
  </p>
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 12px;
    flex-wrap: wrap;
  }

  h3 {
    font-family: var(--mono);
    font-size: 1.15rem;
    font-weight: 650;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .platform {
    font-size: 13px;
    color: var(--muted);
  }

  p {
    margin: 0;
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    margin-top: auto;
    font-size: 15px;
    font-weight: 600;
  }

  .card-links a {
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .card-links a:hover {
    text-decoration: underline;
  }
</style>
