---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import {
  homePath,
  locales,
  profileLinks,
  useTranslations,
  type Locale,
} from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Percorso della stessa pagina in ogni lingua, es. { it: '/', en: '/en/' }. */
  alternates: Record<Locale, string>;
  title?: string;
  description?: string;
  /** Per le pagine che non devono finire nei risultati di ricerca, come la 404. */
  noindex?: boolean;
}

const { locale, alternates, title, description, noindex = false } = Astro.props;
const t = useTranslations(locale);

const pageTitle = title ? `${title} · Mirco Zanzaro` : t('site.title');
const pageDescription = description ?? t('site.description');
const canonical = new URL(alternates[locale], Astro.site);
const otherLocale = locales.find((l) => l !== locale)!;
const year = new Date().getFullYear();
const ogLocale: Record<Locale, string> = { it: 'it_IT', en: 'en_US' };
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(alternates[l], Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.it, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Anteprima del link su LinkedIn, nelle chat e nelle mail. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mirco Zanzaro" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLocale]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.title')} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0f1c2e" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Applica il tema scelto prima del primo disegno, per evitare il lampo del tema sbagliato.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t('nav.skipToContent')}</a>

    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={homePath(locale)}>Mirco Zanzaro</a>
        <nav class="site-nav" aria-label={t('nav.label')}>
          <a class="hide-sm" href={homePath(locale, t('anchor.projects'))}>{t('nav.projects')}</a>
          <a class="hide-sm" href={homePath(locale, t('anchor.method'))}>{t('nav.method')}</a>
          <button class="icon-btn" type="button" data-theme-toggle hidden aria-label={t('nav.themeToggle')}>
            <Icon name="theme" />
          </button>
          <a
            class="lang"
            href={alternates[otherLocale]}
            hreflang={otherLocale}
            lang={otherLocale}
            aria-label={t('nav.languageSwitch')}
          >
            <span>{t('nav.languageShort')}</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-row">
        <span>© {year} Mirco Zanzaro</span>
        <span>
          {t('footer.madeWith')} · <a href={profileLinks.source}>{t('footer.source')}</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      // Il pulsante del tema. Senza JavaScript resta nascosto, e il tema segue il sistema.
      (() => {
        const button = document.querySelector('[data-theme-toggle]');
        if (!button) return;
        button.hidden = false;
        button.addEventListener('click', () => {
          const root = document.documentElement;
          const current =
            root.dataset.theme ??
            (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
        });
      })();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    z-index: 20;
    background: var(--surface);
    color: var(--text);
    padding: 8px 14px;
    border-radius: 8px;
  }

  .skip-link:focus {
    left: 16px;
    top: 12px;
  }

  main:focus {
    outline: none;
  }

  .site-header {
    background: var(--hero-from);
    color: var(--hero-text);
    border-bottom: 1px solid rgb(232 238 247 / 0.08);
  }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 56px;
  }

  .site-header a {
    color: inherit;
    text-decoration: none;
  }

  .site-header :focus-visible {
    outline-color: var(--hero-text);
  }

  .brand {
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .site-nav {
    display: flex;
    gap: 18px;
    align-items: center;
    font-size: 15px;
  }

  .site-nav a:not(.lang):hover {
    text-decoration: underline;
  }

  .lang,
  .icon-btn {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: 999px;
  }

  .lang {
    font-size: 13px;
    font-weight: 600;
  }

  .lang span {
    padding: 2px 10px;
    border: 1px solid rgb(232 238 247 / 0.35);
    border-radius: 999px;
  }

  .lang:hover span {
    border-color: var(--hero-text);
  }

  .icon-btn {
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    padding: 0;
  }

  .icon-btn[hidden] {
    display: none;
  }

  .icon-btn :global(svg) {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 560px) {
    .site-nav {
      gap: 4px;
    }

    .hide-sm {
      display: none;
    }
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 26px 0 40px;
    color: var(--muted);
    font-size: 14px;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
  }
</style>
